   "status": "placeholder",
   "year": 2020
  },
  {
   "file": "gaps.json",
   "kind": "static",
   "note": "query parameters (concepts, min_p, sort, limit) are not applied; filter client-side",
   "route": "/api/gaps",
   "status": "placeholder"
  },
  {
   "file": "gap-details.json",
   "key": "{a}|{b}",
   "kind": "keyed",
   "note": "a and b are the URL-decoded concept ids; only the top gaps have an entry, others are null",
   "route": "/api/gap/{a}/{b}",
   "status": "placeholder"
  },
  {
   "file": "concepts.json",
   "key": "{id}",
   "kind": "keyed",
   "note": "the URL-decoded concept id; a missing entry means no such concept",
   "route": "/api/concept/{id}",
   "status": "placeholder"
  },
  {
   "file": "search.json",
   "kind": "static",
   "note": "query ignored; placeholder",
   "route": "/api/search?q={q}&k={k}",
   "status": "placeholder"
  },
  {
   "file": "open-problems.json",
   "kind": "static",
   "note": "query ignored; placeholder",
   "route": "/api/open-problems",
   "status": "placeholder"
  },
  {
   "file": "coverage-2015.json",
   "kind": "by_year",
   "route": "/api/coverage?year=2015",
