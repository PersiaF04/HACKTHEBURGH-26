{
 "corpus_last_year": 2020,
 "data_label": "synthetic",
 "layout_version": 1,
 "map_years": [
  2015,
  2016,
  2017,
  2018,
  2019,
  2020
 ],
 "note": "Static route map for the files in this directory. Strip the query string except 'year'; 'kind' says how to find the payload; 'status' is placeholder when the file has no data.",
 "routes": [
  {
   "file": "meta.json",
   "kind": "static",
   "route": "/api/meta",
   "status": "placeholder"
  },
  {
   "file": "backtest.json",
   "kind": "static",
   "route": "/api/backtest",
   "status": "placeholder"
  },
  {
   "file": "map-2015.json",
   "kind": "by_year",
   "route": "/api/map?year=2015",
   "status": "placeholder",
   "year": 2015
  },
  {
   "file": "map-2016.json",
   "kind": "by_year",
   "route": "/api/map?year=2016",
   "status": "placeholder",
   "year": 2016
  },
  {
